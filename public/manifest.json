{
  "id": "/",
  "name": "DriveSafe AI - Driver Safety Monitor",
  "short_name": "DriveSafe AI",
  "description": "AI-powered real-time driver safety monitor with camera drowsiness detection, distraction alerts, speed & trip analytics, emergency dispatch, and voice control.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "window-controls-overlay"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "iarc_rating_id": "e8f498c3-4d43-455a-b9c7-5a1d7f6a73c1",
  "prefer_related_applications": false,
  "related_applications": [],
  "categories": [
    "utilities",
    "navigation",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Monitoring",
      "short_name": "Monitor",
      "description": "Start driver safety tracking",
      "url": "/?action=monitor",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Emergency SOS",
      "short_name": "SOS",
      "description": "Trigger emergency alert",
      "url": "/?action=sos",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshot1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "DriveSafe AI Dashboard and Camera HUD"
    },
    {
      "src": "screenshot2.png",
      "sizes": "640x1136",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "DriveSafe AI Mobile Driver Safety HUD"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+drivesafe",
      "url": "/?protocol=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "DriveSafe Quick Status",
      "short_name": "DriveSafe",
      "description": "Quick view driver alertness score",
      "tag": "drivesafe-widget",
      "template": "widget-template",
      "ms_ac_template": "ms-ac-template.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "screenshot2.png",
          "sizes": "640x1136",
          "type": "image/png"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/?action=note"
  },
  "scope_extensions": [
    {
      "origin": "*.run.app"
    }
  ]
}
