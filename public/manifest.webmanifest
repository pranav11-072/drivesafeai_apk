{
  "id": "/",
  "name": "DriveSafe AI - Driver Safety Monitor",
  "short_name": "DriveSafe AI",
  "description": "AI-powered real-time driver safety monitor with camera drowsiness detection, distraction alerts, speed & trip analytics, emergency dispatch, and voice control.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "prefer_related_applications": false,
  "related_applications": [],
  "categories": [
    "utilities",
    "navigation",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
